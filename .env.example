# =====================================================================
# VIGNAI OS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and provide your production credentials before deployment.
# NEVER commit .env files containing real secrets to version control.
# =====================================================================

# 1. Environment & Server Settings
ENVIRONMENT=production
PORT=8000
LOG_LEVEL=INFO

# 2. Security & JWT Configuration
# Generate a cryptographically strong 64-char key (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
SECRET_KEY=replace_with_a_secure_random_64_character_hex_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# 3. Database Connection
# Production: Managed PostgreSQL (e.g. Supabase, Render, Railway, AWS RDS)
# Local Dev / CI: sqlite:///./vignex.db
DATABASE_URL=postgresql://vignai_user:vignai_secure_password@postgres-host.internal:5432/vignai_production_db

# 4. CORS Policy
# Comma-separated list of allowed HTTPS frontend production origins
# Example: https://vignai-os.vercel.app,https://campus.vignan.ac.in
CORS_ORIGINS=https://vignai-os.vercel.app

# 5. AI Engine (Google Gemini 3.6 Flash)
# Backend-only server key; NEVER expose to client/frontend
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AI_PROVIDER=gemini

# 6. File Upload Storage
UPLOAD_DIRECTORY=uploads

# 7. Demo / Staging Data Seeding
# Set to 'false' for production to prevent automatic synthetic demo seeding
ENABLE_DEMO_SEEDING=false

# 8. Frontend Environment Reference
# In frontend deployment (Vercel/Netlify):
# VITE_API_BASE_URL=https://vignai-backend.onrender.com/api
